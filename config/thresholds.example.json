{
  "configuration_version": "0.1.0",
  "sampling": {
    "sample_rate_hz": 1600,
    "window_samples": 1024,
    "capture_period_s": 300,
    "fft_format": "q15"
  },
  "features": {
    "vibration_axes": ["x", "y", "z"],
    "vibration_unit": "g",
    "current_unit": "a",
    "rms_enabled": true,
    "peak_to_peak_enabled": true,
    "crest_factor_enabled": true,
    "band_energy_hz": [50, 400]
  },
  "alerts": {
    "vibration_rms_limit": 0.35,
    "vibration_rms_recovery": 0.30,
    "temperature_c_limit": 65.0,
    "temperature_c_recovery": 60.0,
    "current_a_limit": 1.2,
    "current_a_recovery": 1.0,
    "consecutive_windows": 3,
    "recovery_windows": 3
  },
  "power": {
    "mode_between_captures": "stop",
    "rtc_wakeup_enabled": true
  }
}
